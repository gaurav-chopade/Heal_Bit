# Goes in the frontend ROOT folder (next to package.json), NOT inside src/.
# Vite only exposes variables that start with VITE_.
#
# Development: requests go to /api and the Vite dev server (see vite.config.js) forwards
# them to the Spring Boot backend on http://localhost:8080. Same path as production, and
# no CORS involved. To call the backend directly instead, use http://localhost:8080 here.
VITE_API_BASE_URL=/api
