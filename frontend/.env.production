# Used by "npm run build" (production mode). Overrides values from .env.
#
# In production Nginx serves this build and forwards /api/* to the Spring Boot backend
# (see deploy/nginx-healbit.conf), so the browser only ever talks to its own origin.
# Do NOT leave this empty: src/api/axiosClient.js falls back to http://localhost:8080.
VITE_API_BASE_URL=/api

# Public keys baked into the bundle at build time. Set your production values either here
# or in the shell when building (see DEPLOYMENT.md). The fallbacks in src/constants.js are
# meant for development only.
# VITE_RECAPTCHA_SITE_KEY=
# VITE_RAZORPAY_KEY_ID=
