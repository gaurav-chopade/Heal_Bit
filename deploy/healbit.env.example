# Install on the server as /etc/healbit.env, then lock it down:
#   sudo chmod 600 /etc/healbit.env
# Never commit the real file. No quotes and no spaces around "=".
# Variable names match backend/src/main/resources/application-prod.properties.

# Activates application-prod.properties
SPRING_PROFILES_ACTIVE=prod

# ---- Database (RDS MySQL) ----
# The database name heal-bit contains a hyphen; that is fine inside a JDBC URL.
DB_URL=jdbc:mysql://<rds-endpoint>:3306/heal-bit?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

# ---- Website origin allowed by CORS (scheme + domain, no trailing slash) ----
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ---- Auth ----
# Generate with: openssl rand -base64 48   (at least 32 characters)
JWT_SECRET=<long-random-string>
# Password for the admin account (admin@healbit.com), created on the first start only
ADMIN_PASSWORD=<strong-password>

# ---- reCAPTCHA secret (pair of the site key you build into the frontend) ----
RECAPTCHA_SECRET=<recaptcha-secret>

# ---- Razorpay ----
RAZORPAY_KEY_ID=<key-id>
RAZORPAY_KEY_SECRET=<key-secret>

# ---- Cloudinary (or set CLOUDINARY_ENABLED=false to store uploads on the server disk) ----
CLOUDINARY_ENABLED=true
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# ---- Gmail SMTP (16-character app password, no spaces). Leave empty to disable emails ----
MAIL_USERNAME=
MAIL_PASSWORD=
